# --- providers ---
NVIDIA_NIM_API_KEY =
GROQ_API_KEY =
# second, independent Groq account/key. Used as generate_main's 2nd chain
# link (groq -> groq_secondary -> nim) — must be a genuinely different
# account, not the same key twice, or it does nothing for rate-limit
# resilience.
GROQ_API_KEY_SECONDARY =
GEMINI_API_KEY =
QDRANT_URL =
QDRANT_API_KEY =
LOGFIRE_TOKEN =
# off by default; turn_span() only logs a length+hash of the user's message
# unless this is true, since the message may contain PII (see src/tracing.py)
TRACING_LOG_RAW_MESSAGES = false

# generation chain: groq -> groq (secondary account) -> nim
GROQ_MAIN_MODEL = openai/gpt-oss-120b
GROQ_MAIN_MODEL_SECONDARY = openai/gpt-oss-120b
NIM_MAIN_MODEL = openai/gpt-oss-120b

# planner chain: nim -> groq (reversed from the generation chain)
NIM_PLANNER_MODEL = nvidia/nemotron-3-super-120b-a12b
GROQ_PLANNER_MODEL = openai/gpt-oss-20b

# eval judge: separate model family from both chains above, via Gemini's
# OpenAI-compatible endpoint
GEMINI_EVAL_JUDGE_MODEL = gemini-3.5-flash

# safety/topic gates: called directly against NIM first, falling back to
# the planner chain above if that call fails or gives an unusable verdict
# (see src/guardrails/gates.py)
NEMOGUARD_TOPIC_MODEL = nvidia/llama-3.1-nemoguard-8b-topic-control
NEMOGUARD_SAFETY_MODEL = nvidia/llama-3.1-nemoguard-8b-content-safety

# set true only as a stopgap during a sustained NVIDIA-side outage on
# NeMoGuard content-safety (symptom: every turn's log shows a NeMoGuard
# safety call failing or timing out). Default false — safety has been
# reliable in practice.
GUARDRAIL_SKIP_NEMOGUARD_SAFETY = false
# NeMoGuard topic-control is the one that's been reliably crashing
# (recurring server-side TensorRT-LLM/CUDA error on NVIDIA's endpoint).
# Default true: skip straight to the Groq-backed fallback classifier as
# topic's primary path. Flip to false once NVIDIA's instance is confirmed
# healthy again to give the dedicated model another try.
GUARDRAIL_SKIP_NEMOGUARD_TOPIC = true
GUARDRAIL_TIMEOUT_SECONDS = 3
GUARDRAIL_CIRCUIT_FAILURE_THRESHOLD = 2
GUARDRAIL_CIRCUIT_RECOVERY_SECONDS = 30


# Gemini's only other role in this project: embeddings
GEMINI_EMBEDDING_MODEL = gemini-embedding-001
EMBEDDING_DIM = 768

# --- tunable thresholds (empirical, do not hardcode in code) ---
SEMANTIC_CACHE_SIMILARITY_THRESHOLD = 0.95
RERANK_SCORE_THRESHOLD = 0.5
NO_CONTEXT_CACHE_TTL_SECONDS = 3600
EMBEDDING_CACHE_TTL_SECONDS = 86400
RERANK_FAIL_CLOSED = true
GENERATION_TIMEOUT_SECONDS = 15
PLANNER_TIMEOUT_SECONDS = 4
# hardcoded at 2.0 in an earlier pass — too tight for real hosted Qdrant
# Cloud latency and caused ReadTimeouts on healthy requests, not just
# outages. Also raised the Gemini client (previously no timeout at all).
QDRANT_TIMEOUT_SECONDS = 5
EMBEDDING_TIMEOUT_SECONDS = 10
# breaker for the shared nim/groq/groq-secondary provider chain in
# src/providers/llm.py — separate from GUARDRAIL_CIRCUIT_* above, which
# only covers the two NeMoGuard classifier calls, not general chat
# completions (rewrite, canonicalize-fallback, generation).
PROVIDER_CIRCUIT_FAILURE_THRESHOLD = 2
PROVIDER_CIRCUIT_RECOVERY_SECONDS = 20
CACHE_SCHEMA_VERSION = 3
# bump when the safety/topic/cache policy changes in a way that makes an
# old cached answer unsuitable (e.g. a stricter guardrail prompt) -- this
# one still has to be bumped by hand, since "the policy changed" isn't
# something ingest.py can detect.
CACHE_POLICY_VERSION = 2
# fallback only, used before the first `python ingest.py` run has ever
# written .cache/corpus_version. Once ingest.py has run, the effective
# corpus version comes from a content fingerprint written there instead
# (see src/retrieval/cache.py::_current_corpus_version), so a normal
# re-ingest -- with or without --wipe -- invalidates stale cached answers
# on its own without editing this value.
CORPUS_VERSION = 1

# --- qdrant collections ---
QDRANT_DOCS_COLLECTION = kubernetes_docs
QDRANT_CACHE_COLLECTION = semantic_cache






